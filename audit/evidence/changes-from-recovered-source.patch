+
+class _ProtectedDialogState extends State<ProtectedDialog>
+    with WidgetsBindingObserver {
+  late DraftBuffer buffer;
+  late Json data;
+  bool busy = false, canPop = false;
+  String? error;
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    data = widget.draft?.data ?? widget.initial;
+    buffer = DraftBuffer(
+      widget.controller.repository,
+      type: widget.type,
+      ownerId: widget.ownerId,
+      data: data,
+      initial: widget.draft,
+    );
+  }
+
+  void change(Json next) {
+    setState(() => data = {...data, ...next});
+    buffer.change(data);
+  }
+
+  @override
+  void dispose() {
+    buffer.dispose();
+    WidgetsBinding.instance.removeObserver(this);
+    super.dispose();
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state != AppLifecycleState.resumed) {
+      buffer.flush().catchError((Object e) {
+        buffer.error = e;
+      });
+    }
+  }
+
+  Future<void> pop() async {
+    setState(() => canPop = true);
+    await WidgetsBinding.instance.endOfFrame;
+    if (mounted) Navigator.pop(context);
+  }
+
+  Future<void> close() async {
+    if (busy) return;
+    setState(() => busy = true);
+    try {
+      await buffer.flush();
+      await widget.controller.reload();
+      if (mounted) await pop();
+    } catch (e) {
+      if (mounted &&
+          await unsavedDraft(context, widget.controller.repository, {
+            'type': 'dialog',
+            'draft': buffer.draft.toJson(),
+          }) &&
+          mounted) {
+        try {
+          await widget.controller.repository.discardDialogDraft(
+            buffer.draft.id,
+            buffer.draft.revision,
+          );
+          await pop();
+        } catch (discardError) {
+          if (mounted) setState(() => error = friendlyError(discardError));
+        }
+      }
+    } finally {
+      if (mounted) setState(() => busy = false);
+    }
+  }
+
+  Future<void> save() async {
+    if (busy) return;
+    setState(() {
+      busy = true;
+      error = null;
+    });
+    try {
+      await buffer.flush();
+      await widget.save(data, buffer.draft);
+      await widget.controller.reload();
+      if (mounted) await pop();
+    } catch (e) {
+      if (mounted) setState(() => error = friendlyError(e));
+    }
+    if (mounted) setState(() => busy = false);
+  }
+
+  @override
+  Widget build(BuildContext context) => PopScope(
+    canPop: canPop,
+    onPopInvokedWithResult: (didPop, _) {
+      if (!didPop) close();
+    },
+    child: CallbackShortcuts(
+      bindings: {const SingleActivator(LogicalKeyboardKey.escape): close},
+      child: Focus(
+        autofocus: true,
+        child: FlexModal(
+          maxWidth: widget.maxWidth,
+          title: Text(widget.title),
+          onClose: busy ? null : close,
+          content: AbsorbPointer(
+            absorbing: busy,
+            child: Column(
+              mainAxisSize: MainAxisSize.min,
+              crossAxisAlignment: CrossAxisAlignment.stretch,
+              children: [
+                widget.body(context, data, change),
+                if (error != null)
+                  Padding(
+                    padding: const EdgeInsets.symmetric(vertical: 12),
+                    child: Text(
+                      error!,
+                      style: TextStyle(
+                        color: Theme.of(context).colorScheme.error,
+                      ),
+                    ),
+                  ),
+              ],
+            ),
+          ),
+          actions: [
+            TextButton(
+              onPressed: busy ? null : close,
+              child: const Text('Abbrechen'),
+            ),
+            FilledButton(
+              onPressed: busy ? null : save,
+              child: Text(widget.accept),
+            ),
+          ],
+        ),
+      ),
+    ),
+  );
