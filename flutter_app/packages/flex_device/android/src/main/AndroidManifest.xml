<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="at.flowzym.flex_device">
  <queries><intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent></queries>
  <application>
    <provider android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.materials" android:exported="false"
      android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/flex_material_paths" />
    </provider>
  </application>
</manifest>
